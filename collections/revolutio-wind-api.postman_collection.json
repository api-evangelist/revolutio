          "name": "Get Wind Hazard Analysis",
          "request": {
            "name": "Get Wind Hazard Analysis",
            "description": {
              "content": "Returns site-specific wind hazard parameters according to AS/NZS 1170.2 for the specified coordinates. API key must be included as a query parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "asnzs1170",
                "wind"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "(Required) Your Revolutio Hazard API subscription key"
                },
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<number>",
                  "description": "(Required) Site latitude in decimal degrees"
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<number>",
                  "description": "(Required) Site longitude in decimal degrees"
                },
                {
                  "disabled": false,
                  "key": "h",
                  "value": "<number>",
                  "description": "Structure height in metres"
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "metric",
                  "description": "Output unit system"
                },
                {
                  "disabled": false,
                  "key": "advancedDetection",
                  "value": "true",
                  "description": "Enable ML-based terrain detection"
                },
                {
                  "disabled": false,
                  "key": "googleApiKey",
                  "value": "<string>",
                  "description": "Optional Google API key for elevation data"
                }
              ],
              "variable": []
            },
